# Copy this into the app's Secrets box on Streamlit Community Cloud
# (or into .streamlit/secrets.toml for local runs – that file is git-ignored).

[databricks]
server_hostname = "dbc-xxxxxxxx-xxxx.cloud.databricks.com"   # SQL Warehouses → your warehouse → Connection details
http_path = "/sql/1.0/warehouses/xxxxxxxxxxxxxxxx"           # same page
access_token = "dapi-your-personal-access-token"              # Settings → Developer → Access tokens
check_table = "workspace.ops.connectivity_check"              # written by the week 1 notebook
